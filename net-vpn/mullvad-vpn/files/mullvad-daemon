#!/sbin/openrc-run

name="mullvad-daemon"
description="Mullvad VPN daemon"

command="/usr/bin/mullvad-daemon"
command_args="--disable-stdout-timestamps"
pidfile="/run/${RC_SVCNAME}.pid"

supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
respawn_period=0

output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    need net
    after firewall
}

start_pre() {
    # Delegation is required so the daemon (running as mullvad) can create
    # its own cgroups under the unified hierarchy.
    if ! grep -q nsdelegate /proc/self/mountinfo | grep /sys/fs/cgroup; then
        ebegin "Remounting /sys/fs/cgroup with nsdelegate"
        mount -o remount,nsdelegate /sys/fs/cgroup
        eend $?
    fi
}

start_post() {
    local cg_dir="/sys/fs/cgroup/mullvad-exclusions"
    local max_wait=10
    local i=0

    while [ ! -d "$cg_dir" ] && [ $i -lt $max_wait ]; do
        sleep 1
        i=$((i+1))
    done

    if [ ! -d "$cg_dir" ]; then
        eerror "Mullvad cgroup2 directory not found after ${max_wait}s at ${cg_dir}"
        return 1
    fi

    chown root:mullvad "$cg_dir"
    chmod 775 "$cg_dir"

    [ -f "$cg_dir/cgroup.procs" ] && chown root:mullvad "$cg_dir/cgroup.procs" && chmod 664 "$cg_dir/cgroup.procs"

    ebegin "Applied group write permissions to Mullvad cgroup2"
    eend 0
}